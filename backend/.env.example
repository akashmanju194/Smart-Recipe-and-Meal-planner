# ==========================================
# SmartRecipe Backend Environment Variables
# ==========================================

# Port for Express server
PORT=5001

# Allowed Frontend URL for CORS (comma-separated for multiple)
FRONTEND_URL=http://localhost:5173

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# PostgreSQL Database Connection URL (Local or Neon)
# Example Local: postgresql://postgres:postgres@localhost:5432/smartrecipe?schema=public
# Example Neon: postgresql://user:password@ep-xyz.region.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/smartrecipe?schema=public

# Cloudinary Configuration (Optional - for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
